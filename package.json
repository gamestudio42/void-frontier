{
  "name": "void-frontier",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @void-frontier/game dev",
    "build": "pnpm --filter @void-frontier/game build",
    "preview": "pnpm --filter @void-frontier/game preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@void-frontier/content": "workspace:*",
    "@void-frontier/kernel": "workspace:*",
    "@void-frontier/simulation": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
